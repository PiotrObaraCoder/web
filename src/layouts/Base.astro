---
import tokens from '../../design/tokens.json';
import type { Dict } from '../i18n/pl';
import { CV_URL, EMAIL, FIGMA_URL, GITHUB_URL, LINKEDIN_URL, REPO_URL } from '../i18n/pl';
import '../styles/global.css';

interface Props { t: Dict }
const { t } = Astro.props;

// CSS custom properties generated from design/tokens.json (mirror of the Figma variables)
const cssName = (k: string) => k.replace('/', '-');
const colorVars = (mode: 'light' | 'dark') =>
  Object.entries(tokens.color).map(([k, v]) => `--color-${cssName(k)}:${v[mode]};`).join('');
const scaleVars =
  Object.entries(tokens.spacing).map(([k, v]) => `--space-${k}:${v}px;`).join('') +
  Object.entries(tokens.radius).map(([k, v]) => `--radius-${k}:${v}px;`).join('') +
  `--font-sans:"${tokens.font.sans}",system-ui,-apple-system,"Segoe UI",sans-serif;` +
  `--font-mono:"${tokens.font.mono}",ui-monospace,"SFMono-Regular",Menlo,monospace;` +
  Object.entries(tokens.type).map(([k, v]) => `--type-${k}-size:${v.size}px;--type-${k}-weight:${v.weight};--type-${k}-line:${v.lineHeight};`).join('') +
  `--button-min-height:${tokens.component['button/min-height']}px;--input-height:${tokens.component['input/height']}px;--focus-width:${tokens.component['focus/outline-width']}px;`;
const tokenCss = `:root{${colorVars('light')}${scaleVars}color-scheme:light}` +
  `@media (prefers-color-scheme: dark){:root{${colorVars('dark')}color-scheme:dark}}`;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const altHref = new URL(t.otherLang.href, Astro.site).href;
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Piotr Obara',
  jobTitle: t.hero.label,
  email: `mailto:${EMAIL}`,
  url: 'https://piotr-obara.pl/',
  image: 'https://piotr-obara.pl/img/portrait-800.webp',
  address: { '@type': 'PostalAddress', addressLocality: 'Lublin', addressCountry: 'PL' },
  sameAs: [LINKEDIN_URL, GITHUB_URL],
  knowsAbout: ['Software testing', 'Test analysis', 'REST API testing', 'SQL', 'WCAG', 'Playwright'],
  hasCredential: { '@type': 'EducationalOccupationalCredential', name: 'ISTQB Certified Tester Foundation Level 4.0' }
};
---
<!doctype html>
<html lang={t.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={t.lang} href={canonical} />
    <link rel="alternate" hreflang={t.otherLang.code} href={altHref} />
    <link rel="alternate" hreflang="x-default" href="https://piotr-obara.pl/" />
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://piotr-obara.pl/img/og.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="theme-color" content={tokens.color['bg/inverse'].light} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;600&family=IBM+Plex+Sans:wght@400;600;700&display=swap" />
    <style is:inline set:html={tokenCss}></style>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(person)}></script>
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skip}</a>
    <header class="topbar" data-testid="topbar">
      <div class="topbar-inner">
        <a class="brand" href={t.lang === 'pl' ? '/' : '/en/'}>Piotr Obara</a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">{t.nav.menu}</button>
        <nav id="site-nav" class="site-nav" aria-label={t.nav.label}>
          <ul>
            {t.nav.items.map((i) => <li><a href={i.href}>{i.label}</a></li>)}
          </ul>
        </nav>
        <div class="topbar-actions">
          <a class="lang-link" href={t.otherLang.href} hreflang={t.otherLang.code} lang={t.otherLang.code} aria-label={t.otherLang.name}>{t.otherLang.label}</a>
          <a class="button button-primary" href={CV_URL} download>{t.nav.cv}</a>
        </div>
      </div>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap footer-inner">
        <p>© 2026 Piotr Obara</p>
        <ul>
          <li><a href={FIGMA_URL} rel="noreferrer" target="_blank">{t.footer.design}</a></li>
          <li><a href={REPO_URL} rel="noreferrer" target="_blank">{t.footer.code}</a></li>
          <li>{t.footer.tested}</li>
        </ul>
      </div>
    </footer>
    <script>
      // Mobile navigation (acceptance criterion 1)
      const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const nav = document.getElementById('site-nav');
      if (toggle && nav) {
        const setOpen = (open: boolean) => {
          toggle.setAttribute('aria-expanded', String(open));
          nav.toggleAttribute('data-open', open);
        };
        toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
        nav.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) setOpen(false); });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') { setOpen(false); toggle.focus(); }
        });
      }
    </script>
  </body>
</html>
