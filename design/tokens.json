{
  "$source": "Figma: piotr-obara.pl — Design Spec (https://www.figma.com/design/yC0ZGGqHkUO7Y10Mz4iyMy)",
  "color": {
    "bg/page":            { "light": "#F4F6F8", "dark": "#0B1622" },
    "bg/panel":           { "light": "#FFFFFF", "dark": "#122232" },
    "bg/inverse":         { "light": "#0E2235", "dark": "#060E17" },
    "text/primary":       { "light": "#0E2235", "dark": "#E4EBF2" },
    "text/muted":         { "light": "#52657A", "dark": "#98A9BA" },
    "text/inverse":       { "light": "#FFFFFF", "dark": "#E4EBF2" },
    "border/default":     { "light": "#D5DDE5", "dark": "#24384C" },
    "accent/redline":     { "light": "#C2185B", "dark": "#FF7AA8" },
    "accent/redline-soft":{ "light": "#FBE4EE", "dark": "#3A1A2A" },
    "status/pass":        { "light": "#17784A", "dark": "#5FD09A" },
    "status/pass-soft":   { "light": "#E1F3E9", "dark": "#12342A" },
    "status/fail":        { "light": "#B42F25", "dark": "#FF8A7E" },
    "status/fail-soft":   { "light": "#FBE7E5", "dark": "#3D1C1A" },
    "status/warn":        { "light": "#8A5A00", "dark": "#F0BF5A" },
    "status/warn-soft":   { "light": "#FBF0D9", "dark": "#3A2C10" },
    "status/info":        { "light": "#2A5EA8", "dark": "#86B4F5" },
    "status/info-soft":   { "light": "#E3ECF8", "dark": "#162C4A" }
  },
  "spacing": { "2xs": 4, "xs": 8, "sm": 12, "md": 16, "lg": 24, "xl": 32, "2xl": 48, "3xl": 72 },
  "radius": { "sm": 4, "md": 6, "lg": 12, "full": 999 },
  "font": { "sans": "IBM Plex Sans", "mono": "IBM Plex Mono" },
  "type": {
    "display": { "family": "sans", "weight": 700, "size": 52, "lineHeight": 1.1 },
    "h2":      { "family": "sans", "weight": 700, "size": 32, "lineHeight": 1.2 },
    "h3":      { "family": "sans", "weight": 600, "size": 20, "lineHeight": 1.3 },
    "lead":    { "family": "sans", "weight": 400, "size": 18, "lineHeight": 1.6 },
    "body":    { "family": "sans", "weight": 400, "size": 16, "lineHeight": 1.6 },
    "small":   { "family": "sans", "weight": 400, "size": 14, "lineHeight": 1.5 },
    "label":   { "family": "mono", "weight": 600, "size": 12, "lineHeight": 1.3, "letterSpacing": 0.08, "uppercase": true }
  },
  "component": {
    "button/min-height": 44,
    "input/height": 44,
    "focus/outline-width": 3
  }
}
